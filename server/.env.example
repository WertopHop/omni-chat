# omni-chat server configuration.
#
# Copy this file to `.env` and fill in the values, or just run
# `scripts/gen-config.sh` - it creates `.env` from this template, generates
# every secret and renders the runtime configuration into `generated/`.
#
# Never commit `.env`: it holds the VPN keys, S3 credentials and LiveKit keys.

# Public domain of the chat. An A record must point to this server.
# `localhost` is the default for local experiments.
CHAT_DOMAIN=localhost

# Contact address for ACME (Let's Encrypt). Optional, may stay empty.
ACME_EMAIL=

# Host ports. 443 is the single public entry point (VPN + fallback to the chat),
# 80 is used for ACME HTTP-01 and redirects, 8443 stays internal.
HTTP_PORT=80
HTTPS_PORT=8443
VPN_PORT=443
LIVEKIT_TCP_PORT=7881
LIVEKIT_UDP_PORT_START=50000
LIVEKIT_UDP_PORT_END=50100

# Image tags. Pin them before going to production.
XRAY_IMAGE=ghcr.io/xtls/xray-core:latest
CHAT_TAG=v0.15.5
LIVEKIT_IMAGE=ghcr.io/stoatchat/livekit-server:v1.9.14

# ---------------------------------------------------------------------------
# Secrets. Leave empty: `scripts/gen-config.sh` fills them in on first run.
# ---------------------------------------------------------------------------

# VPN identity (VLESS UUID + Reality keypair + short id)
XRAY_UUID=
XRAY_PRIVATE_KEY=
XRAY_PUBLIC_KEY=
XRAY_SHORT_ID=

# Voice: LiveKit API key/secret. Must be mirrored into the chat backend,
# therefore the REVOLT__ duplicates below are written by the generator too.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Object storage (attachments, avatars)
S3_ROOT_USER=
S3_ROOT_PASSWORD=

# Chat backend secrets (environment overrides of the generated chat.toml)
REVOLT__FILES__ENCRYPTION_KEY=
REVOLT__PUSHD__VAPID__PRIVATE_KEY=
REVOLT__PUSHD__VAPID__PUBLIC_KEY=
REVOLT__API__LIVEKIT__NODES__WORLDWIDE__KEY=
REVOLT__API__LIVEKIT__NODES__WORLDWIDE__SECRET=
